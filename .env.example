# =================================================================
# Liveli — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# =================================================================

# ---- App ---------------------------------------------------------
# Used to construct absolute URLs and decide marketing vs app subdomain.
NEXT_PUBLIC_APP_URL=https://app.liveli.co.uk
NEXT_PUBLIC_MARKETING_URL=https://liveli.co.uk

# ---- Analytics ---------------------------------------------------
# GA4 measurement ID. Set ONLY on Vercel's Production scope — leaving
# it unset on Preview and Development keeps PR previews and local dev
# from polluting prod analytics with our own clicks. The marketing
# layout renders nothing when this is unset, so it's safe to omit.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---- Clerk -------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat
# Svix signing secret for the Clerk webhook (org.created / user.created /
# org.deleted / user.deleted). Copy from Clerk Dashboard → Webhooks →
# your endpoint → Signing Secret. Required in production; without it the
# webhook returns 500 and Clerk retries.
CLERK_WEBHOOK_SECRET=whsec_xxx

# ---- Google Cloud ------------------------------------------------
GCP_PROJECT_ID=liveli-496609
GCP_REGION=europe-west4
GCP_BQ_LOCATION=EU
GCP_FIRESTORE_DATABASE=(default)

# Workload Identity Federation provider path. Required for Vercel runtime
# OIDC → STS exchange. Format:
#   projects/<num>/locations/global/workloadIdentityPools/<pool>/providers/<provider>
GCP_WORKLOAD_IDENTITY_PROVIDER=

# Runtime service account email — the SA the runtime impersonates after
# the WIF token exchange. Format: liveli-runtime@<project>.iam.gserviceaccount.com
GCP_RUNTIME_SERVICE_ACCOUNT=

# For local dev only: path to a service-account JSON file with the same
# roles the deployed app uses. Production uses Workload Identity Federation
# (no key file) — leave this unset on Vercel.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- Vertex AI ---------------------------------------------------
# Vertex AI region for Gemini models. MUST be a real regional string
# (europe-west1, us-central1, asia-northeast1, etc.) — the SDK formats
# the URL as `${region}-aiplatform.googleapis.com`, so "global" would
# produce a non-existent hostname. We default to europe-west1 for EU
# residency. Check Gemini model availability per region in the
# Model Garden card.
VERTEX_AI_REGION=europe-west1
# Default: claude-sonnet-4-6 (Anthropic Claude via Vertex AI).
# Dispatch in /api/chat/route.ts switches on the model prefix:
#   - `claude-*` → AI SDK (@ai-sdk/google-vertex/anthropic) path in agent-claude.ts
#   - `gemini-*` → legacy @google-cloud/vertexai path in agent.ts (rollback option)
# Both require Model Garden enable per project (Anthropic models need
# accepting the Anthropic terms in the Vertex AI Model Garden once).
VERTEX_AI_MODEL=claude-sonnet-4-6

# Optional model routing: when set, "simple" classified queries (single-
# value lookups, short questions, no edit context, no analytics trigger
# words) route to this lighter/cheaper model. Heuristic classifier in
# src/lib/agent-claude.ts:classifyComplexity. Recommended:
# claude-haiku-4-5@20251001 (~10× cheaper than Sonnet for simple Q&A).
# Leave unset to disable routing and use VERTEX_AI_MODEL for everything.
# VERTEX_AI_MODEL_LIGHT=claude-haiku-4-5@20251001

# ---- GCS bucket names (created by Terraform) ---------------------
GCS_UPLOADS_BUCKET=liveli-uploads-eu
GCS_AGENT_ARTIFACTS_BUCKET=liveli-agent-eu

# ---- Cloud Scheduler (per-connector recurring syncs) -------------
# Service account email used to sign OIDC tokens on the scheduled-sync
# HTTP target. Falls back to liveli-runtime@<project>.iam.gserviceaccount.com.
LIVELI_SCHEDULER_SA_EMAIL=

# Base URL the Cloud Scheduler job will POST to. Falls back to
# NEXT_PUBLIC_APP_URL → https://app.liveli.co.uk.
LIVELI_SCHEDULER_TARGET_URL=

# Origin to verify in the OIDC audience claim (defence against Host
# header injection). Falls back to NEXT_PUBLIC_APP_URL. MUST match the
# domain Cloud Scheduler is actually configured to hit.
LIVELI_SCHEDULER_AUDIENCE_ORIGIN=

# ---- Pricing / billing ------------------------------------------
# USD → GBP conversion rate. Falls back to 0.79 (mid-2026). For accurate
# per-customer billing, wire this to a daily-refreshed Firestore-cached
# value from exchangerate.host or similar.
LIVELI_USD_TO_GBP=

# ---- Private-testing email allowlist ------------------------------
# Comma-separated list of emails allowed to sign up while we're in
# private testing. Empty == public mode (everyone allowed).
# Belt-and-braces: also configure Clerk Dashboard → User & Authentication
# → Restrictions → Allowed email addresses with the same list.
# Tracked in Linear: remove for launch.
LIVELI_ALLOWED_EMAILS=jay@liveli.co.uk,jayclarke8393@gmail.com
